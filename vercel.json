  "buildCommand": "npm run build --workspace @bondly/commercial-workspace",
  "outputDirectory": "apps/commercial-workspace/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }]
}
